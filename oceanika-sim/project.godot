[layer_names]

3d_physics/layer_1="things"
3d_physics/layer_2="objects"
3d_physics/layer_3="pool"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/generate_all_kinematic_contacts=true
jolt_physics_3d/queries/enable_ray_cast_face_index=true

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0, 0.40049347, 0.5948451, 1)
